{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bio-claim-firewall/spec/worlds/clinical_trials_claim.schema.json",
  "title": "Clinical trial disclosure consistency claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["nct_id", "sponsor", "intervention", "sec_accession", "exhibit_locator", "asserted_span_sha256", "as_of"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "sponsor": {"type": "string", "minLength": 1},
    "intervention": {"type": "string", "minLength": 1},
    "sec_accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "exhibit_locator": {"type": "string", "minLength": 1},
    "asserted_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "as_of": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
