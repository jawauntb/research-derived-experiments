{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bio-claim-firewall/spec/worlds/clinical_trials_evidence.schema.json",
  "title": "Clinical trial disclosure derived evidence",
  "type": "object",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "source", "nct_id", "sponsor", "intervention", "accepted_at", "status"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "source": {"const": "clinicaltrials-gov-api-v2"},
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
        "sponsor": {"type": "string", "minLength": 1},
        "intervention": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "status": {"type": "string"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "source", "nct_id", "cik", "sponsor", "intervention", "sec_accession", "exhibit_locator", "span_locator", "asserted_span_sha256", "identity_span_locator", "identity_span_sha256", "review_artifact_sha256", "relationship_reviewed", "reviewer_role", "accepted_at"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "source": {"const": "sec-edgar-submissions-and-archives"},
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "sponsor": {"type": "string", "minLength": 1},
        "intervention": {"type": "string", "minLength": 1},
        "sec_accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "exhibit_locator": {"type": "string", "minLength": 1},
        "span_locator": {"type": "string", "minLength": 1},
        "asserted_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity_span_locator": {"type": "string", "minLength": 1},
        "identity_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relationship_reviewed": {"const": true},
        "reviewer_role": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    }
  ]
}
