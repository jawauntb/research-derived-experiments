{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bio-claim-firewall/spec/world.schema.json",
  "title": "Evidence world",
  "description": "Immutable registry entry selecting one versioned, isolated evidence bundle and typed claim adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["world_id", "version", "source_allowlist", "claim_fields", "capabilities", "adapter"],
  "properties": {
    "world_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "world_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modality": {"type": "string"},
    "description": {"type": "string"},
    "source_allowlist": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_contracts": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string"}
        }
      }
    },
    "claim_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adapter": {"type": "string", "minLength": 1},
    "parser_schema": {"type": "object"}
  }
}
