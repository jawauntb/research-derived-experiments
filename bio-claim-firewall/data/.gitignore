# Phase 2 pilot world: only manifests/scripts/README/.gitignore are tracked.
# Every raw download and every derived snapshot/ledger file is reproducible
# from data/scripts/*.py + data/manifests/*.{yaml,json} and is intentionally
# NOT committed (disk footprint + provenance belongs in the scripts, not git).
raw/
processed/
ontology_snapshots/
evidence_records/

# Never commit the actual license *text* dumps either -- they are fetched
# verbatim from each source at download time and regenerated by the same
# download_*.py scripts. Keep this directory itself out of git so a stale
# copy can never silently diverge from what a source's license page says
# today; data/README.md documents each source's license tag instead.
LICENSES/
