<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nightly summary pass at 23:30.

  Install:
    cp launchd/com.gazenotes.nightly.plist ~/Library/LaunchAgents/
    # edit the paths below to match your install, then:
    launchctl load ~/Library/LaunchAgents/com.gazenotes.nightly.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gazenotes.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/gazenotes</string>
    <string>nightly</string>
    <string>today</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/gazenotes-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gazenotes-nightly.log</string>
</dict>
</plist>
