/-!
# Structural Intelligence — Compiler-Tomography CT-1 core

The algebraic backbone of Theorem CT-1 (MDL identification) in the
*Compiler Tomography* paper (`papers/compiler_tomography/paper.md`,
§2).  The full Wald/Rissanen consistency statement of CT-1 requires
probability, log-likelihood, KL divergence and BIC bounds; this file
isolates the **combinatorial core**:

> If the compiler family `{K θ : θ ∈ Θ}` is **identifiable** — every
> pair `θ ≠ θ'` disagrees on at least one `(s, x)` — and a data set
> `D` contains a distinguishing witness for every wrong parameter
> `θ ≠ θ*`, then `θ*` is the unique element of `Θ` consistent with
> `D`.

This is what makes the MDL argmin *identify* `θ*` uniquely once
enough data has been seen: consistency with `D` collapses to the
singleton `{θ*}`, so any argmin-of-a-monotone-code-length must land
on `θ*`.  The passage from "eventually every wrong `θ` gets refuted"
to "this happens with high probability at rate `O(√(log N / N))`" is
a standard concentration + KL-positivity argument that requires real
analysis and is left as `Mathlib` follow-up (see the package
`README.md`).

Everything here is pure Lean 4 core (no `Mathlib`).  For simplicity
we model deterministic-support compilers as `K : Θ → S → X → Bool`
— `K θ s x = true` iff `x` is in the support of `K θ (· | s)` — so
that "disagrees at `(s, x)`" is decidable and no distribution
formalism is needed.  Extending to probabilistic compilers (where
disagreement is at the level of measures on `X`) is orthogonal and
lives at the same combinatorial level once one plugs in
mathlib probability.
-/

namespace StructuralIntelligence

universe u v w

section CompilerTomography

variable {Θ : Type u} {S : Type v} {X : Type w}

/-- A compiler family `K : Θ → S → X → Bool` is **identifiable** if
    distinct parameter values induce distinct compilers, i.e., every
    pair `θ ≠ θ'` disagrees on at least one input `(s, x)`.

    Paper reference: identifiability assumption of Theorem CT-1
    (`papers/compiler_tomography/paper.md`, §2, "Setup (CT-1)"). -/
def IsIdentifiable (K : Θ → S → X → Bool) : Prop :=
  ∀ θ θ' : Θ, θ ≠ θ' → ∃ s : S, ∃ x : X, K θ s x ≠ K θ' s x

/-- A parameter `θ` is **consistent with the data** `D`, under the
    assumption that `D` was generated by the true compiler `K θStar`,
    if for every observed pair `(s, x) ∈ D` the candidate `K θ`
    gives the same verdict as `K θStar`.  In the
    deterministic-support model this is exactly "no observed pair
    falsifies `θ`." -/
def ConsistentWith (K : Θ → S → X → Bool) (θStar : Θ)
    (D : List (S × X)) (θ : Θ) : Prop :=
  ∀ p ∈ D, K θ p.1 p.2 = K θStar p.1 p.2

/-- A parameter `θ` is **refuted by** the data `D` (under truth
    `θStar`) if some pair `(s, x) ∈ D` exhibits a disagreement
    between `K θ` and `K θStar`. -/
def RefutedBy (K : Θ → S → X → Bool) (θStar : Θ)
    (D : List (S × X)) (θ : Θ) : Prop :=
  ∃ p ∈ D, K θ p.1 p.2 ≠ K θStar p.1 p.2

/-- **Not-consistent ↔ refuted.**  A parameter fails the consistency
    test at exactly the observed pairs on which it disagrees with
    the truth.  Proved classically because the "some pair" quantifier
    is over a list, so the disagreement witness has to be extracted
    by contradiction. -/
theorem not_consistent_iff_refuted
    {K : Θ → S → X → Bool} {θStar : Θ}
    {D : List (S × X)} {θ : Θ} :
    ¬ ConsistentWith K θStar D θ ↔ RefutedBy K θStar D θ := by
  classical
  constructor
  · intro hNotCons
    apply Classical.byContradiction
    intro hNotRef
    apply hNotCons
    intro p hpD
    apply Classical.byContradiction
    intro hne
    exact hNotRef ⟨p, hpD, hne⟩
  · rintro ⟨p, hpD, hne⟩ hCons
    exact hne (hCons p hpD)

/-- **CT-1-core (Identifiability implies uniqueness).**

    Suppose every `θ ≠ θStar` is **refuted by** the data set `D` —
    for every such `θ`, some observed pair `(s, x) ∈ D` witnesses
    `K θ s x ≠ K θStar s x`.  Then `θStar` is the unique parameter
    consistent with `D`:

    `ConsistentWith K θStar D θ ↔ θ = θStar`.

    In particular, the MDL argmin restricted to zero-training-error
    hypotheses (i.e., the consistent parameters) is exactly `{θStar}`
    — the identification claim of Theorem CT-1 at the combinatorial
    level.  The probability that "enough data was collected to
    refute every wrong parameter" concentrates to one at the standard
    Wald/BIC rate; this file only handles the algebraic core (see
    `README.md`). -/
theorem identifiability_implies_unique_by_witness
    {K : Θ → S → X → Bool} {θStar : Θ} {D : List (S × X)}
    (hAllRefuted : ∀ θ : Θ, θ ≠ θStar → RefutedBy K θStar D θ)
    (θ : Θ) :
    ConsistentWith K θStar D θ ↔ θ = θStar := by
  classical
  constructor
  · intro hCons
    apply Classical.byContradiction
    intro hne
    obtain ⟨p, hpD, hne_pt⟩ := hAllRefuted θ hne
    exact hne_pt (hCons p hpD)
  · rintro rfl
    intro _ _
    rfl

/-- **Constructive companion.**  Given any listing `thetaList` of
    candidate parameters, identifiability lets us *build* a data set
    `D` that refutes every wrong parameter appearing in the list —
    pick any distinguishing pair per wrong `θ` and pile them into a
    list.

    Combined with `identifiability_implies_unique_by_witness`, this
    shows that for finite (list-enumerable) `Θ`, identifiability
    suffices to construct a finite `D` that isolates `θStar` uniquely
    among all listed parameters (see
    `identifiability_isolates_theta_star`). -/
theorem identifiability_yields_refuting_data
    {K : Θ → S → X → Bool}
    (hIdent : IsIdentifiable K) (θStar : Θ) (thetaList : List Θ) :
    ∃ D : List (S × X),
      ∀ θ ∈ thetaList, θ ≠ θStar → RefutedBy K θStar D θ := by
  classical
  induction thetaList with
  | nil => exact ⟨[], fun θ hθ => absurd hθ List.not_mem_nil⟩
  | cons θ₀ rest ih =>
    obtain ⟨D₀, hD₀⟩ := ih
    by_cases hEq : θ₀ = θStar
    · refine ⟨D₀, ?_⟩
      intro θ hθ hne
      rcases List.mem_cons.mp hθ with hθeq | hθrest
      · exact absurd (hθeq.trans hEq) hne
      · exact hD₀ θ hθrest hne
    · obtain ⟨s, x, hne⟩ := hIdent θ₀ θStar hEq
      refine ⟨(s, x) :: D₀, ?_⟩
      intro θ hθ hneStar
      rcases List.mem_cons.mp hθ with hθeq | hθrest
      · refine ⟨(s, x), List.mem_cons_self, ?_⟩
        show K θ s x ≠ K θStar s x
        rw [hθeq]; exact hne
      · obtain ⟨p, hpD, hpne⟩ := hD₀ θ hθrest hneStar
        exact ⟨p, List.mem_cons_of_mem _ hpD, hpne⟩

/-- **CT-1-core (full combinatorial form).**  Under identifiability,
    for any finite list `thetaList` of candidate parameters there
    exists a data set `D` on which the parameters consistent with
    `D` are exactly `{θStar}` (restricted to the list).

    This is the "MDL identifies `θ*` from a finite data set" claim
    at the pure-combinatorial level — no probability, no log-
    likelihood, no BIC. -/
theorem identifiability_isolates_theta_star
    {K : Θ → S → X → Bool}
    (hIdent : IsIdentifiable K) (θStar : Θ) (thetaList : List Θ) :
    ∃ D : List (S × X), ∀ θ ∈ thetaList,
      ConsistentWith K θStar D θ ↔ θ = θStar := by
  classical
  obtain ⟨D, hD⟩ :=
    identifiability_yields_refuting_data hIdent θStar thetaList
  refine ⟨D, ?_⟩
  intro θ hθ
  constructor
  · intro hCons
    apply Classical.byContradiction
    intro hne
    obtain ⟨p, hpD, hnp⟩ := hD θ hθ hne
    exact hnp (hCons p hpD)
  · rintro rfl
    intro _ _
    rfl

end CompilerTomography

end StructuralIntelligence
